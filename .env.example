# AZmovies configuration example — Phase 1, no application reads this yet.
# Copy to an ignored local env file only after implementation approval.
# Never put real credentials in this example, chat, screenshots or commits.
# NODE_ENV is managed by Next/test tooling, not hardcoded here.

# PostgreSQL: supply the full TLS-verified connection string through secret storage.
# Use separate development/test/staging/production databases and least-privilege roles.
DATABASE_URL=
DATABASE_POOL_MAX=5

# Canonical server/application origin. For an Arena preview, use the exact assigned
# HTTPS preview origin when testing auth; browser API requests remain relative.
BETTER_AUTH_URL=http://localhost:3000
# Generate a strong secret outside Git (at least 32 random bytes before encoding).
BETTER_AUTH_SECRET=
# Comma-separated exact origins only. Add the assigned preview origin explicitly;
# no wildcards and no production preview exception.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# One-time controlled admin bootstrap only; not a public signup or login bypass.
# Supply the password temporarily through secret storage, then remove it from runtime.
ADMIN_NAME=AZmovies Owner
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Metadata integration is OFF until permission/licence and egress are confirmed.
# Use the provider's server-side read credential, never a NEXT_PUBLIC variable.
TMDB_ENABLED=false
TMDB_API_READ_TOKEN=

# Optional scheduler credential; blank keeps the internal scheduled route disabled.
# The hosting scheduler must inject this separately from the metadata credential.
CRON_SECRET=

# Official Telegram HTTPS URL supplied by the owner; blank hides the floating link.
TELEGRAM_URL=

# Nonsecret operational default; never log request bodies or credentials.
LOG_LEVEL=info
